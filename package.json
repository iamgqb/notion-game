{
  "name": "notion-game",
  "version": "1.0.0",
  "private": true,
  "description": "Sync Steam game data to Notion and back it up to Cloudflare R2.",
  "scripts": {
    "sync": "node src/index.js",
    "backup": "node src/backup.js",
    "backup:audit": "node src/backup-audit.js",
    "site:data": "node src/site/export-data.js",
    "site:prepare": "node src/site/prepare-deploy.js",
    "site:mark-deployed": "node src/site/mark-deployed.js",
    "site:serve": "node src/site/serve.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1107.0"
  }
}
